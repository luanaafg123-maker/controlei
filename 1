Child(t);t.select();document.execCommand('copy');document.body.removeChild(t);H('success');T('Copiado!')})}function sPmt(){H('medium');if(confirm('Simular pagamento confirmado?')){S.activated=true;S.activationPlan=S.selectedPlan;const e=new Date();e.setDate(e.getDate()+S.selectedPlan.period);S.activationExpiry=e.toISOString();S.pixPayment={...S.pixPayment,status:'paid'};storage.save();H('success');T('Plano ativado! 🎉');render();setTimeout(()=>nav('dashboard'),1500)}}function eN(){H('medium');const sh=sS('✏️ Editar Nome',`<div class="form-row"><label class="form-label">Nome do negócio</label><input type="text" class="form-input" id="editName" value="${S.name}" maxlength="30"></div><button class="btn btn-primary" id="saveName" style="margin-bottom:20px">Salvar</button>`);setTimeout(()=>{$('#editName').focus();$('#saveName').addEventListener('click',()=>{const n=$('#editName').value.trim();if(!n){H('error');T('Nome obrigatório','error');return}S.name=n;storage.save();H('success');sh.close();T('Atualizado!');render()})},100)}function eD(){H('light');storage.export()}function iD(i){if(i.files?.[0]){H('light');storage.import(i.files[0])}}function cD(){H('medium');storage.clear()}function aU(){if(nW){nW.postMessage({type:'SKIP_WAITING'});nW.addEventListener('statechange',()=>{if(nW.state==='activated')window.location.reload()})}}function bG(){let sx=0;const sv=$('.scroll-view');if(!sv)return;sv.addEventListener('touchstart',(e)=>{sx=e.touches[0].clientX},{passive:true});sv.addEventListener('touchend',(e)=>{const diff=e.changedTouches[0].clientX-sx;if(diff>100&&S.currentView!=='dashboard'){const bm={history:'dashboard',reports:'dashboard',settings:'dashboard',payment:'settings',pix:'payment'};if(bm[S.currentView])nav(bm[S.currentView])}},{passive:true})}function init(){storage.load();sw.init();render();setTimeout(()=>{const sp=$('#splash');if(sp)sp.classList.add('hidden')},2000);setInterval(()=>{const te=$('.status-time');if(te)te.textContent=new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})},3e4);console.log('Controlei Native v'+C.VERSION+' iniciado')}return{init,nav,sM,cS,oT,aQI,oAI,dT,sP,gP,cPC,sPmt,eN,eD,iD,cD,aU}})();const app=App;if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>app.init());else app.init();
