<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#000000">
<meta name="description" content="Controle financeiro que parece app nativo">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Controlei</title>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
html{height:100%;overflow:hidden;-webkit-font-smoothing:antialiased}
body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',Roboto,sans-serif;background:#000;color:#fff;height:100%;overflow:hidden;position:fixed;width:100%;overscroll-behavior-y:none}
:root{--accent:#30D158;--danger:#FF453A;--warning:#FF9F0A;--bg-primary:#000;--bg-secondary:#1C1C1E;--bg-tertiary:#2C2C2E;--glass:rgba(28,28,30,0.7);--glass-border:rgba(255,255,255,0.08);--text-primary:#fff;--text-secondary:rgba(255,255,255,0.6);--text-tertiary:rgba(255,255,255,0.3);--separator:rgba(255,255,255,0.1)}
.splash{position:fixed;inset:0;z-index:99999;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s ease,transform .6s ease}
.splash.hidden{opacity:0;transform:scale(1.1);pointer-events:none}
.splash-icon{width:100px;height:100px;background:linear-gradient(135deg,#30D158,#28A745);border-radius:26px;display:flex;align-items:center;justify-content:center;font-size:50px;box-shadow:0 20px 60px rgba(48,209,88,0.3);animation:splashPulse 2s ease infinite}
@keyframes splashPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.splash-title{margin-top:24px;font-size:28px;font-weight:700;letter-spacing:-.5px}
.splash-subtitle{margin-top:8px;font-size:15px;color:var(--text-secondary)}
.app{height:100%;display:flex;flex-direction:column;position:relative;background:var(--bg-primary)}
.status-bar{height:44px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;font-size:14px;font-weight:600;color:var(--text-primary);position:relative;z-index:100}
.status-time{font-variant-numeric:tabular-nums}
.nav-header{padding:0 20px 12px;position:relative;z-index:50}
.nav-header-large{padding:8px 20px 16px}
.nav-header-title{font-size:32px;font-weight:700;letter-spacing:-.8px}
.nav-header-subtitle{font-size:15px;color:var(--text-secondary);margin-top:4px}
.nav-header-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.nav-back{width:36px;height:36px;border-radius:50%;background:var(--bg-tertiary);border:none;color:var(--accent);font-size:20px;display:flex;align-items:center;justify-content:center;cursor:pointer}
.scroll-view{flex:1;overflow-y:auto;overflow-x:hidden;padding:0 20px 120px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.scroll-view::-webkit-scrollbar{display:none}
.glass-card{background:var(--glass);backdrop-filter:blur(40px) saturate(180%);-webkit-backdrop-filter:blur(40px) saturate(180%);border:1px solid var(--glass-border);border-radius:20px;padding:20px;margin-bottom:16px}
.balance-hero{text-align:center;padding:20px 0 32px}
.balance-label{font-size:13px;font-weight:500;color:var(--text-secondary);text-transform:uppercase;letter-spacing:1px;margin-bottom:8px}
.balance-amount{font-size:48px;font-weight:700;letter-spacing:-1.5px;line-height:1}
.balance-amount.positive{color:var(--accent)}
.balance-amount.negative{color:var(--danger)}
.segmented-control{display:flex;background:var(--bg-tertiary);border-radius:10px;padding:2px;margin-bottom:20px}
.segment{flex:1;padding:8px;text-align:center;font-size:13px;font-weight:600;color:var(--text-secondary);border-radius:8px;cursor:pointer;transition:all .3s ease}
.segment.active{background:var(--accent);color:#000;box-shadow:0 2px 8px rgba(48,209,88,0.3)}
.list-group{background:var(--bg-secondary);border-radius:12px;overflow:hidden;margin-bottom:24px}
.list-item{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--separator);cursor:pointer;transition:background .2s;position:relative}
.list-item:last-child{border-bottom:none}
.list-item:active{background:var(--bg-tertiary)}
.list-item-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;margin-right:12px;flex-shrink:0}
.list-item-icon.green{background:rgba(48,209,88,0.15)}
.list-item-icon.red{background:rgba(255,69,58,0.15)}
.list-item-icon.blue{background:rgba(10,132,255,0.15)}
.list-item-icon.yellow{background:rgba(255,159,10,0.15)}
.list-item-icon.purple{background:rgba(175,82,222,0.15)}
.list-item-content{flex:1;min-width:0}
.list-item-title{font-size:16px;font-weight:400;color:var(--text-primary)}
.list-item-subtitle{font-size:13px;color:var(--text-secondary);margin-top:2px}
.list-item-value{font-size:16px;font-weight:600;color:var(--text-primary);margin-left:12px}
.list-item-value.positive{color:var(--accent)}
.list-item-value.negative{color:var(--danger)}
.list-item-chevron{color:var(--text-tertiary);font-size:18px;margin-left:8px}
.fab-container{position:fixed;bottom:100px;right:20px;z-index:90;display:flex;flex-direction:column;gap:12px}
.fab{width:60px;height:60px;border-radius:50%;border:none;font-size:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 30px rgba(0,0,0,0.4);transition:transform .3s cubic-bezier(0.34,1.56,0.64,1)}
.fab:active{transform:scale(0.9)}
.fab-primary{background:linear-gradient(135deg,var(--accent),#28A745);color:#000}
.fab-secondary{background:var(--bg-tertiary);color:var(--danger);width:50px;height:50px;font-size:24px}
.tab-bar{position:fixed;bottom:0;left:0;right:0;height:calc(84px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:rgba(0,0,0,0.85);backdrop-filter:blur(50px) saturate(180%);-webkit-backdrop-filter:blur(50px) saturate(180%);border-top:1px solid var(--separator);display:flex;justify-content:space-around;align-items:center;z-index:100}
.tab-item{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 16px;border:none;background:none;color:var(--text-tertiary);font-size:10px;font-weight:500;cursor:pointer;transition:color .3s;position:relative}
.tab-item.active{color:var(--accent)}
.tab-item-icon{font-size:24px;transition:transform .3s cubic-bezier(0.34,1.56,0.64,1)}
.tab-item.active .tab-item-icon{transform:translateY(-2px)}
.sheet-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);backdrop-filter:blur(3px);z-index:1000;opacity:0;pointer-events:none;transition:opacity .3s ease}
.sheet-overlay.show{opacity:1;pointer-events:all}
.sheet{position:fixed;bottom:0;left:0;right:0;background:var(--bg-secondary);border-radius:24px 24px 0 0;padding:20px 0 calc(20px + env(safe-area-inset-bottom));transform:translateY(100%);transition:transform .4s cubic-bezier(0.16,1,0.3,1);z-index:1001;max-height:85vh;overflow-y:auto}
.sheet-overlay.show+.sheet,.sheet.show{transform:translateY(0)}
.sheet-handle{width:40px;height:5px;background:var(--text-tertiary);border-radius:3px;margin:0 auto 20px}
.sheet-title{font-size:20px;font-weight:700;padding:0 20px 16px;text-align:center}
.form-row{padding:0 20px;margin-bottom:16px}
.form-label{display:block;font-size:13px;font-weight:500;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;padding-left:4px}
.form-input{width:100%;padding:16px;background:var(--bg-tertiary);border:1px solid var(--separator);border-radius:12px;font-size:17px;font-family:inherit;color:var(--text-primary);-webkit-appearance:none;transition:border-color .3s,box-shadow .3s}
.form-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(48,209,88,0.15)}
.form-input::placeholder{color:var(--text-tertiary)}
.btn{width:calc(100% - 40px);margin:0 20px;padding:16px;border-radius:12px;border:none;font-size:17px;font-weight:600;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.btn:active{transform:scale(0.97)}
.btn-primary{background:var(--accent);color:#000}
.btn-secondary{background:var(--bg-tertiary);color:var(--accent)}
.toast-container{position:fixed;top:60px;left:50%;transform:translateX(-50%);z-index:10001;display:flex;flex-direction:column;gap:8px;pointer-events:none;width:90%;max-width:400px}
.toast{background:var(--bg-secondary);backdrop-filter:blur(20px);border:1px solid var(--glass-border);color:var(--text-primary);padding:14px 18px;border-radius:14px;font-size:14px;font-weight:500;box-shadow:0 10px 40px rgba(0,0,0,0.4);animation:toastSlide .4s cubic-bezier(0.16,1,0.3,1);display:flex;align-items:center;gap:10px;pointer-events:all}
.toast.success{border-left:4px solid var(--accent)}
.toast.error{border-left:4px solid var(--danger)}
@keyframes toastSlide{from{transform:translateY(-30px);opacity:0}to{transform:translateY(0);opacity:1}}
.setup-screen{height:100%;display:flex;flex-direction:column;justify-content:center;padding:40px 32px;background:var(--bg-primary)}
.setup-logo{text-align:center;margin-bottom:48px}
.setup-icon{width:90px;height:90px;background:linear-gradient(135deg,var(--accent),#28A745);border-radius:24px;display:inline-flex;align-items:center;justify-content:center;font-size:44px;margin-bottom:20px;box-shadow:0 20px 60px rgba(48,209,88,0.25)}
.setup-title{font-size:32px;font-weight:800;letter-spacing:-1px;margin-bottom:8px}
.setup-subtitle{font-size:16px;color:var(--text-secondary);line-height:1.5}
.empty-state{text-align:center;padding:60px 20px;color:var(--text-secondary)}
.empty-icon{font-size:64px;margin-bottom:16px;opacity:.3}
.empty-title{font-size:18px;font-weight:600;color:var(--text-primary);margin-bottom:8px}
.empty-text{font-size:15px;line-height:1.5}
.update-banner{position:fixed;top:44px;left:12px;right:12px;background:var(--accent);color:#000;padding:12px 16px;border-radius:14px;display:flex;align-items:center;justify-content:space-between;z-index:9999;transform:translateY(-100px);transition:transform .5s cubic-bezier(0.16,1,0.3,1);box-shadow:0 10px 40px rgba(48,209,88,0.3);font-weight:600;font-size:14px}
.update-banner.show{transform:translateY(0)}
.update-banner button{background:rgba(0,0,0,0.15);border:none;padding:6px 14px;border-radius:20px;font-weight:700;font-size:13px;cursor:pointer;color:#000}
</style>
</head>
<body>
<div class="splash" id="splash"><div class="splash-icon">📊</div><div class="splash-title">Controlei</div><div class="splash-subtitle">Seu dinheiro, seu controle</div></div>
<div class="update-banner" id="updateBanner"><span>🚀 Nova versão disponível</span><button onclick="app.applyUpdate()">Atualizar</button></div>
<div class="toast-container" id="toastContainer"></div>
<div class="app" id="app"></div>
<script>
const App=(()=>{const C={STORAGE_KEY:'controlei_native_v2',FREE_LIMIT:20,PLANS:[{id:'monthly',name:'Mensal',price:9.90,period:30,periodLabel:'mês',recommended:false},{id:'quarterly',name:'Trimestral',price:24.90,period:90,periodLabel:'3 meses',recommended:true,savings:'17%'},{id:'yearly',name:'Anual',price:79.90,period:365,periodLabel:'ano',recommended:false,savings:'33%'}],VERSION:'2.1.0'};let S={setup:false,name:'',phone:'',mode:'store',transactions:[],items:[],activated:false,activationExpiry:null,activationPlan:null,currentView:'dashboard',selectedPlan:null,pixPayment:null};let swR=null,nW=null;const $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);const H=(t='light')=>{if(navigator.vibrate){const p={light:10,medium:20,heavy:30,success:[10,50,10],error:[30,50,30]};navigator.vibrate(p[t]||10)}};const storage={load(){try{const r=localStorage.getItem(C.STORAGE_KEY);if(r)S={...S,...JSON.parse(r),currentView:'dashboard'}}catch(e){}},save(){try{localStorage.setItem(C.STORAGE_KEY,JSON.stringify(S))}catch(e){T('Erro ao salvar dados','error')}},export(){const b=new Blob([JSON.stringify({...S,exportDate:new Date().toISOString(),version:C.VERSION},null,2)],{type:'application/json'});const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=`controlei-backup-${new Date().toISOString().split('T')[0]}.json`;a.click();URL.revokeObjectURL(u);H('success');T('Backup salvo!')},import(f){const r=new FileReader();r.onload=(e)=>{try{const d=JSON.parse(e.target.result);if(d.transactions&&Array.isArray(d.transactions)){S={...S,...d,currentView:'dashboard'};storage.save();H('success');T('Backup restaurado!');nav('dashboard')}else throw new Error()}catch(err){H('error');T('Arquivo inválido','error')}};r.readAsText(f)},clear(){if(confirm('⚠️ Todos os dados serão apagados permanentemente. Continuar?')){localStorage.removeItem(C.STORAGE_KEY);S={setup:false,name:'',phone:'',mode:'store',transactions:[],items:[],activated:false,activationExpiry:null,activationPlan:null,currentView:'dashboard',selectedPlan:null,pixPayment:null};H('success');T('Dados apagados');nav('dashboard')}}};const sw={async init(){if(!('serviceWorker'in navigator))return;try{swR=await navigator.serviceWorker.register('sw.js');setInterval(()=>swR.update(),36e5);swR.addEventListener('updatefound',()=>{nW=swR.installing;if(nW){nW.addEventListener('statechange',()=>{if(nW.state==='installed'&&navigator.serviceWorker.controller)showUB()})}});navigator.serviceWorker.addEventListener('message',(e)=>{if(e.data?.type==='UPDATE_AVAILABLE')showUB()})}catch(e){}}};function showUB(){const b=$('#updateBanner');if(b)b.classList.add('show')}function T(m,t='success'){const c=$('#toastContainer'),el=document.createElement('div');el.className=`toast ${t}`;const i={success:'✓',error:'✕',warning:'⚠'};el.innerHTML=`<span style="font-size:16px">${i[t]}</span><span>${m}</span>`;c.appendChild(el);setTimeout(()=>{el.style.opacity='0';el.style.transform='translateY(-20px)';setTimeout(()=>el.remove(),300)},3000)}const fmt={money:v=>`R$ ${(v||0).toFixed(2).replace('.',',')}`,date:d=>new Date(d).toLocaleDateString('pt-BR',{day:'2-digit',month:'short'}),time:d=>new Date(d).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}),dateFull:d=>new Date(d).toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'})};function gTT(){const t=new Date().toISOString().split('T')[0];return S.transactions.filter(x=>x.date.startsWith(t))}function gTS(){const x=gTT();return{income:x.filter(t=>t.type==='income').reduce((s,t)=>s+t.value,0),expense:x.filter(t=>t.type==='expense').reduce((s,t)=>s+t.value,0),balance:x.filter(t=>t.type==='income').reduce((s,t)=>s+t.value,0)-x.filter(t=>t.type==='expense').reduce((s,t)=>s+t.value,0),count:x.length}}function gTC(){return S.transactions.length}function iL(){return!S.activated&&gTC()>=C.FREE_LIMIT}function iE(){return S.activated&&S.activationExpiry&&new Date(S.activationExpiry)<new Date()}function cAT(){return(S.activated&&!iE())||gTC()<C.FREE_LIMIT}function nav(v){H('light');S.currentView=v;render()}function render(){const a=$('#app');if(!S.setup){a.innerHTML=rS();bS();return}const V={dashboard:rD,history:rH,reports:rR,settings:rSe,payment:rP,pix:rPi};a.innerHTML=V[S.currentView]?V[S.currentView]():'';bG()}function rS(){return`<div class="setup-screen"><div class="setup-logo"><div class="setup-icon">📊</div><div class="setup-title">Controlei</div><div class="setup-subtitle">Controle financeiro simples<br>para comerciantes de bairro</div></div><div style="padding:0 8px"><div class="form-row"><label class="form-label">Nome do negócio</label><input type="text" class="form-input" id="setupName" placeholder="Ex: Padaria do João" maxlength="30"></div><div class="form-row"><label class="form-label">Celular (opcional)</label><input type="tel" class="form-input" id="setupPhone" placeholder="(11) 99999-9999"></div><div class="form-row"><label class="form-label">Tipo</label><div class="segmented-control"><div class="segment active" data-mode="store" onclick="app.sM(this)">🏪 Loja</div><div class="segment" data-mode="service" onclick="app.sM(this)">🔧 Serviço</div></div></div><button class="btn btn-primary" onclick="app.cS()" style="margin-top:8px">Começar →</button></div></div>`}let sM='store';function sM(el){H('light');$$('.segment').forEach(s=>s.classList.remove('active'));el.classList.add('active');sM=el.dataset.mode}function cS(){const n=$('#setupName').value.trim();if(!n){H('error');T('Digite o nome do negócio','error');return}S.setup=true;S.name=n;S.phone=$('#setupPhone').value.trim();S.mode=sM;storage.save();H('success');T('Bem-vindo! 🎉');nav('dashboard')}function bS(){setTimeout(()=>$('#setupName')?.focus(),500)}function rD(){const st=gTS(),tx=gTT().sort((a,b)=>b.id-a.id),c=gTC(),lp=Math.min((c/C.FREE_LIMIT)*100,100);return`<div class="status-bar"><span class="status-time">${new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</span><span class="status-icons">📶 🔋</span></di